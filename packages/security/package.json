  },
  "homepage": "https://github.com/cslugts/cslug/tree/main/packages/security",
  "keywords": [
    "cslug",
    "bun",
    "framework",
    "security",
    "csp",
    "nonce",
    "security.txt",
    "audit-log",
    "lockout",
    "haveibeenpwned"
  ],
  "exports": {
