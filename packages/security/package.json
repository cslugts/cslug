{
  "name": "@cslug/security",
  "version": "0.12.0",
  "description": "Content-Security-Policy nonces, IP filter and per-IP limit, security.txt, account lockout, breached passwords and an audit log for cslug apps.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cslugts/cslug.git",
