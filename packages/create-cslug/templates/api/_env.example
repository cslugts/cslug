APP_ENV=development
# LOG_LEVEL=info                         # debug, info, warn, error
# LOG_FORMAT=pretty                      # json (production default) or pretty
APP_URL=http://localhost:3000
# TLS_CERT=storage/certs/dev.pem          # local HTTPS: `cslug dev:cert myapp.test` writes these
# TLS_KEY=storage/certs/dev-key.pem
APP_KEY=                                  # `cslug key:generate --write`
DATABASE_URL=postgres://cslug:cslug@localhost:5432/{{db}}
REDIS_URL=redis://localhost:6379
