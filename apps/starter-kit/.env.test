# Used by `bun test` (Bun loads .env.test). Variables already set in the environment win, so CI or a local
# shell can point DATABASE_URL elsewhere. Test-only values: never use this key anywhere else.
APP_ENV=test
APP_URL=http://localhost:3000
APP_KEY=test-key-test-key-test-key-test-key-0123
DATABASE_URL=postgres://cslug:cslug@localhost:5432/starter_kit_test
REDIS_URL=redis://localhost:6379/14
MAIL_TRANSPORT=log
